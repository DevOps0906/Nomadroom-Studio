erDiagram
  workspaces {
    uuid id PK
    text name
    timestamptz created_at
  }
  workspace_members {
    uuid workspace_id PK,FK
    uuid user_id PK,FK
    text role
    timestamptz created_at
  }
  profiles {
    uuid id PK
    uuid workspace_id FK
    text name
    text market
    text format
    text category
    integer min_views
    numeric max_growth_pct
    text__ keywords
    boolean cc_only
    boolean include_broadcast
    boolean selected
    string more_1_cols
  }
  broadcaster_channels {
    uuid id PK
    uuid workspace_id FK
    text channel_id
    text channel_title
    timestamptz created_at
  }
  workers {
    uuid id PK
    uuid workspace_id FK
    text name
    text token_hash
    timestamptz revoked_at
    timestamptz created_at
  }
  jobs {
    uuid id PK
    uuid workspace_id FK
    uuid requested_by FK
    uuid claimed_by FK
    text kind
    text status
    uuid__ profile_ids
    jsonb params
    text idempotency_key
    integer retry_count
    boolean stop_requested
    jsonb result
    string more_4_cols
  }
  job_profile_runs {
    uuid id PK
    uuid workspace_id FK
    uuid job_id FK
    uuid profile_id FK
    integer position
    text chrome_state
    text detail
    integer collected_count
    text status
    timestamptz updated_at
  }
  worker_heartbeats {
    uuid worker_id PK,FK
    uuid workspace_id FK
    uuid current_job_id FK
    timestamptz last_seen_at
    jsonb chrome
  }
  candidates {
    uuid id PK
    uuid workspace_id FK
    uuid rep_profile_id FK
    uuid first_job_id FK
    text video_id
    text title
    text thumbnail_url
    text genre
    text category
    text format
    text market
    text channel_id
    string more_8_cols
  }
  observations {
    uuid id PK
    uuid workspace_id FK
    uuid candidate_id FK
    uuid job_id FK
    timestamptz observed_at
    bigint view_count
    boolean license_cc
    text channel_id
    text source
  }
  candidate_verdicts {
    uuid id PK
    uuid workspace_id FK
    uuid candidate_id FK
    uuid profile_id FK
    uuid prev_observation_id FK
    uuid curr_observation_id FK
    text status
    text reason
    numeric growth_pct
    timestamptz judged_at
  }
  api_quota_daily {
    date day PK
    integer units
  }
  production_jobs {
    uuid id PK
    uuid workspace_id FK
    uuid candidate_id FK
    uuid rights_confirmed_by FK
    uuid claimed_by FK
    uuid requested_by FK
    text title
    text format
    text status
    text failed_stage
    text error_code
    text transcribe_state
    string more_19_cols
  }
  edit_revisions {
    uuid id PK
    uuid workspace_id FK
    uuid approved_by FK
    uuid created_by FK
    uuid job_id
    text lang
    integer rev_no
    integer schema_version
    jsonb spec
    text origin
    jsonb validation
    timestamptz approved_at
    string more_2_cols
  }
  production_assets {
    uuid id PK
    uuid workspace_id FK
    uuid job_id
    text kind
    text storage_path
    text mime
    bigint size_bytes
    numeric duration_sec
    text status
    uuid render_run_id
    uuid created_by
    timestamptz created_at
  }
  render_runs {
    uuid id PK
    uuid workspace_id FK
    uuid claimed_by FK
    uuid requested_by FK
    uuid job_id
    uuid revision_id
    text lang
    integer attempt
    uuid retry_of
    text idempotency_key
    text preset_version
    text status
    string more_11_cols
  }
